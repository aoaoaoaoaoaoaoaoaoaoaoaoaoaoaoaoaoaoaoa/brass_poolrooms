#!/bin/sh
set -eu

usage() {
    printf 'usage: scripts/exhibit-service [gallery|atelier|font-atelier] [install [PORT]|uninstall|start|stop|restart|status]\n' >&2
}

exhibit=${1:-}
[ "$#" -ge 1 ] && shift
case "$exhibit" in
    gallery)
        unit_name=brass-poolrooms-gallery.service
        description='Brass Poolrooms Web Gallery'
        default_port=4173
        port_key=GalleryPort
        web_command=web-gallery
        manager=gallery-service
        title='Poolrooms gallery service'
        registry_name=brass-poolrooms.toml
        beast_name='Brass Poolrooms'
        beast_description='Interactive WebGPU gallery for the Poolrooms widget forge.'
        ;;
    atelier)
        unit_name=brass-poolrooms-foundry-atelier.service
        description='Brass Poolrooms Foundry Optics Atelier'
        default_port=4181
        port_key=AtelierPort
        web_command=web-atelier
        manager=atelier-service
        title='Foundry Optics Atelier service'
        registry_name=brass-foundry-atelier.toml
        beast_name='Foundry Optics Atelier'
        beast_description='Configure Brass Poolrooms metals, lighting, die topologies, hardware coupons, and monoglyph gauges.'
        ;;
    font-atelier)
        unit_name=brass-poolrooms-font-raster-atelier.service
        description='Brass Poolrooms Font Raster Atelier'
        default_port=4182
        port_key=FontAtelierPort
        web_command=web-font-atelier
        manager=font-atelier-service
        title='Font Raster Atelier service'
        registry_name=brass-font-raster-atelier.toml
        beast_name='Font Raster Atelier'
        beast_description='Compare Poolrooms typefaces, semantic sizes, weights, raster laws, and hover-help typography through WGPU.'
        ;;
    *) usage; exit 2 ;;
esac

action=${1:-status}
case "$action" in
    install) [ "$#" -le 2 ] || { usage; exit 2; } ;;
    status) [ "$#" -le 1 ] || { usage; exit 2; } ;;
    uninstall|start|stop|restart) [ "$#" -eq 1 ] || { usage; exit 2; } ;;
    *) usage; exit 2 ;;
esac

port=$default_port
if [ "$action" = install ]; then
    port=${2:-$port}
    case "$port" in
        ''|*[!0-9]*) printf 'invalid port: %s\n' "$port" >&2; exit 2 ;;
    esac
    if [ "$port" -eq 0 ] || [ "$port" -gt 65535 ]; then
        printf 'invalid fixed port: %s\n' "$port" >&2
        exit 2
    fi
fi

case ${XDG_CONFIG_HOME:-} in
    /*) config_home=$XDG_CONFIG_HOME ;;
    '') config_home=$HOME/.config ;;
    *)
        printf 'ignoring relative XDG_CONFIG_HOME=%s\n' "$XDG_CONFIG_HOME" >&2
        config_home=$HOME/.config
        ;;
esac
case ${XDG_DATA_HOME:-} in
    /*) data_home=$XDG_DATA_HOME ;;
    '') data_home=$HOME/.local/share ;;
    *)
        printf 'ignoring relative XDG_DATA_HOME=%s\n' "$XDG_DATA_HOME" >&2
        data_home=$HOME/.local/share
        ;;
esac
unit_dir=$config_home/systemd/user
unit_path=$unit_dir/$unit_name
registry_dir=$config_home/bestiary/services.d
registry_path=$registry_dir/$registry_name
icon_dir=$data_home/bestiary/icons
icon_path=$icon_dir/brass-poolrooms.svg
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)
web_exhibit=$root/scripts/$web_command
icon_source=$root/assets/brass-poolrooms.svg
marker="# Generated by $root/scripts/$manager; reinstall rather than editing."

unit_escape() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/%/%%/g'
}

unit_path_escape() {
    printf '%s' "$1" | sed -e 's/\\/\\x5c/g' -e 's/ /\\x20/g' -e 's/%/%%/g'
}

owned() {
    [ ! -L "$1" ] && [ -f "$1" ] && [ "$(sed -n '1p' "$1")" = "$marker" ]
}

claim() {
    if { [ -e "$1" ] || [ -L "$1" ]; } && ! owned "$1"; then
        printf 'refusing to replace unmanaged path: %s\n' "$1" >&2
        exit 1
    fi
}

claim_registry() {
    if [ -e "$registry_path" ] || [ -L "$registry_path" ]; then
        if ! owned "$registry_path" &&
            { [ -L "$registry_path" ] || [ ! -f "$registry_path" ] ||
                [ "$(cat "$registry_path")" != "$(render_registry_body)" ]; }; then
            printf 'refusing to replace unmanaged path: %s\n' "$registry_path" >&2
            exit 1
        fi
    fi
}

claim_icon() {
    if [ -e "$icon_path" ] || [ -L "$icon_path" ]; then
        if [ -L "$icon_path" ] || [ ! -f "$icon_path" ] ||
            ! cmp -s "$icon_source" "$icon_path"; then
            printf 'refusing to replace unmanaged path: %s\n' "$icon_path" >&2
            exit 1
        fi
    fi
}

render_registry_body() {
    printf 'name = "%s"\n' "$beast_name"
    printf 'url = "http://localhost:%s/"\n' "$port"
    printf 'description = "%s"\n' "$beast_description"
    printf 'icon = "brass-poolrooms.svg"\n'
    printf '\n[unit]\n'
    printf 'scope = "user"\n'
    printf 'name = "%s"\n' "$unit_name"
}

render_registry() {
    printf '%s\n' "$marker"
    render_registry_body
}

remove_unclaimed_icon() {
    for fragment in "$registry_dir"/*.toml; do
        [ -f "$fragment" ] || continue
        if grep -Fqx 'icon = "brass-poolrooms.svg"' "$fragment"; then
            return
        fi
    done
    cmp -s "$icon_source" "$icon_path" && rm -f "$icon_path"
}

case "$action" in
    install)
        claim "$unit_path"
        claim_registry
        claim_icon
        bestiary=$(command -v bestiary) || {
            printf 'Localhost Bestiary is required; command not found: bestiary\n' >&2
            exit 1
        }
        "$web_exhibit" build
        service_path=
        for tool in cargo jq python3; do
            executable=$(command -v "$tool") || {
                printf 'required command not found: %s\n' "$tool" >&2
                exit 1
            }
            directory=$(dirname -- "$executable")
            case :$service_path: in
                *:"$directory":*) ;;
                *) service_path=${service_path:+$service_path:}$directory ;;
            esac
        done
        mkdir -p "$unit_dir" "$registry_dir" "$icon_dir"
        unit_temporary=$(mktemp "$unit_path.XXXXXXXX")
        registry_temporary=$(mktemp "$registry_path.XXXXXXXX")
        icon_temporary=$(mktemp "$icon_path.XXXXXXXX")
        cleanup() {
            rm -f "$unit_temporary" "$registry_temporary" "$icon_temporary"
        }
        trap cleanup EXIT HUP INT TERM
        escaped_root_path=$(unit_path_escape "$root")
        escaped_web_exhibit=$(unit_escape "$web_exhibit")
        escaped_path=$(unit_escape "$service_path")
        {
            printf '%s\n' "$marker"
            printf '# %s=%s\n' "$port_key" "$port"
            printf '[Unit]\n'
            printf 'Description=%s\n' "$description"
            printf '\n[Service]\n'
            printf 'Type=notify\n'
            printf 'NotifyAccess=main\n'
            printf 'TimeoutStartSec=15s\n'
            printf 'WorkingDirectory=%s\n' "$escaped_root_path"
            printf 'Environment="PATH=%s"\n' "$escaped_path"
            printf 'ExecStart="%s" serve-built %s\n' "$escaped_web_exhibit" "$port"
            printf 'Restart=on-failure\n'
            printf 'RestartSec=2s\n'
            printf 'RestartPreventExitStatus=98\n'
            printf 'NoNewPrivileges=yes\n'
            printf 'PrivateTmp=yes\n'
            printf 'ProtectSystem=strict\n'
            printf 'ProtectHome=read-only\n'
            printf 'RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6\n'
            printf 'LockPersonality=yes\n'
            printf 'TasksMax=32\n'
            printf 'UMask=0077\n'
            printf '\n[Install]\n'
            printf 'WantedBy=default.target\n'
        } >"$unit_temporary"
        render_registry >"$registry_temporary"
        install -m 0644 "$icon_source" "$icon_temporary"
        chmod 0644 "$unit_temporary" "$registry_temporary"
        mv "$unit_temporary" "$unit_path"
        mv "$registry_temporary" "$registry_path"
        mv "$icon_temporary" "$icon_path"
        trap - EXIT HUP INT TERM
        systemctl --user daemon-reload
        systemctl --user enable "$unit_name"
        systemctl --user restart "$unit_name"
        "$bestiary" check
        printf '%s: http://127.0.0.1:%s\n' "$title" "$port"
        printf 'Localhost Bestiary: http://localhost:8245/\n'
        ;;
    uninstall)
        claim "$unit_path"
        claim_registry
        if owned "$unit_path"; then
            systemctl --user disable --now "$unit_name" 2>/dev/null || true
        fi
        rm -f "$unit_path" "$registry_path"
        remove_unclaimed_icon
        systemctl --user daemon-reload
        systemctl --user reset-failed "$unit_name" 2>/dev/null || true
        if bestiary=$(command -v bestiary); then
            "$bestiary" check
        fi
        printf 'Removed %s and %s\n' "$unit_path" "$registry_path"
        ;;
    start|stop|restart)
        systemctl --user "$action" "$unit_name"
        ;;
    status)
        systemctl --user --no-pager --full status "$unit_name"
        ;;
esac
